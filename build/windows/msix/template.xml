<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="nekoscriptsmanage.exe"
        Arguments=""
        InstallLocation="C:\Program Files\My Company\NekoScriptsManage">
    </Installer>
    <PackageInformation
        PackageName="NekoScriptsManage"
        PackageDisplayName="NekoScriptsManage"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="0.1.0.0"
        PackageDescription="清爽可爱风悬浮快速启动器与本地脚本定时管家">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.neko.scriptsmanage"
                Description="清爽可爱风悬浮快速启动器与本地脚本定时管家"
                DisplayName="NekoScriptsManage"
                ExecutableName="nekoscriptsmanage.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>NekoScriptsManage</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>清爽可爱风悬浮快速启动器与本地脚本定时管家</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="nekoscriptsmanage.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
